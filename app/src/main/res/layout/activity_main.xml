<?xml version="1.0" encoding="utf-8"?>
<!--
    Main screen of CampusLife (portrait).
    The screen is split into two equal halves with layout weights:
    the top half is the welcome banner, the bottom half holds the four
    topic ImageButtons in a two-by-two grid.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Banner: campus photo with the welcome text drawn on top of it -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Decorative background photo, cropped to fill the banner -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <!-- Banner title (40sp is the only fixed size allowed by the specification) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/welcome_message"
            android:textColor="@color/white"
            android:textSize="40sp" />
    </FrameLayout>

    <!-- Topic buttons: two rows that share the bottom half equally -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- First row: Facilities and Events -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Facilities: icon button with its label underneath -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/imagebuttonFacilities"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/topic_facilities"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_facilities" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/topic_facilities"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </LinearLayout>

            <!-- Events: icon button with its label underneath -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/imagebuttonEvents"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/topic_events"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_events" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/topic_events"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Second row: Clubs and Support -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Clubs: icon button with its label underneath -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/imagebuttonClubs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/topic_clubs"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_clubs" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/topic_clubs"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </LinearLayout>

            <!-- Support: icon button with its label underneath -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/imagebuttonSupport"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/topic_support"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_btn_support" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/topic_support"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
